{
  "expo": {
    "name": "Hermes Bot",
    "slug": "hermes-bot-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#1d1d1f",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.hermesbot.mobile",
      "buildNumber": "23",
      "deploymentTarget": "17.0",
      "infoPlist": {
        "CFBundleDevelopmentRegion": "en",
        "CFBundleLocalizations": [
          "en",
          "zh-Hans",
          "zh-Hant"
        ],
        "NSPhotoLibraryUsageDescription": "允许选择照片发送给智能体",
        "NSCameraUsageDescription": "允许拍照发送给智能体",
        "NSMicrophoneUsageDescription": "允许语音输入",
        "NSSpeechRecognitionUsageDescription": "允许语音识别",
        "UIBackgroundModes": ["audio", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 Hermes Bot 选择照片并发送给你的智能体。",
          "cameraPermission": "允许 Hermes Bot 拍摄照片并发送给你的智能体。",
          "microphonePermission": "允许 Hermes Bot 使用麦克风进行语音输入。"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "允许 Hermes Bot 使用麦克风进行语音输入。",
          "speechRecognitionPermission": "允许 Hermes Bot 在手机上把语音转成文字。"
        }
      ]
    ]
  }
}
